PROFILE_NAME=desktop
HYPRLAND_PROFILE=desktop
WEATHER_LOCATION=Vilnius
WALLPAPER_DIR=$HOME/Wallpapers
KEYBOARD_LAYOUTS=us,lt
# Target hardware: Intel Core i7-8700, NVIDIA GeForce RTX 2080 Ti.
CPU_PROFILE_BACKEND=power-profiles-daemon
NVIDIA_DRIVER_PACKAGE=nvidia-open
EXPECTED_CPU_SUBSTRING=i7-8700
EXPECTED_GPU_SUBSTRING="RTX 2080 Ti"
# Change to 1 only after desktop-preflight output has been reviewed, monitor
# geometry is set in modules/profiles/desktop.lua and performance is verified.
DESKTOP_PORT_READY=1
