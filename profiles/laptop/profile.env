PROFILE_NAME=laptop
HYPRLAND_PROFILE=laptop
WEATHER_LOCATION=Vilnius
WALLPAPER_DIR=$HOME/Wallpapers
KEYBOARD_LAYOUTS=us,lt
CPU_PROFILE_BACKEND=power-profiles-daemon
# Optional Wayland-vPets placement. The cat stays inside the compact laptop
# panel and is shown only when wpets/wpets-all is installed.
VPET_ENABLED=1
VPET_MONITOR=eDP-1
VPET_HEIGHT=40
VPET_SLOT_WIDTH=100
VPET_X_OFFSET=232
VPET_Y_OFFSET=8
