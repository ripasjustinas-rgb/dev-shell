#!/usr/bin/env bash
set -Eeuo pipefail

watch_clipboard() {
  wl-paste --type "$1" --watch cliphist store
}

watch_clipboard text &
text_watcher=$!
watch_clipboard image &
image_watcher=$!

cleanup() {
  kill "$text_watcher" "$image_watcher" 2>/dev/null || true
  wait "$text_watcher" "$image_watcher" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

wait -n "$text_watcher" "$image_watcher"
