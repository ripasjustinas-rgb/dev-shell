#!/usr/bin/env sh
set -eu

if ! command -v checkupdates >/dev/null 2>&1; then
  printf '%s\n' '!'
  exit 0
fi

# checkupdates uses a private sync DB and returns 2 when no updates are pending.
# Do not turn real failures into a misleading zero.
status=0
updates=$(checkupdates 2>/dev/null) || status=$?

case "$status" in
  0)
    printf '%s\n' "$updates" | awk 'NF { count++ } END { print count + 0 }'
    ;;
  2)
    printf '%s\n' '0'
    ;;
  *)
    printf '%s\n' '!'
    ;;
esac
