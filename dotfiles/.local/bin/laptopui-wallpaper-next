#!/usr/bin/env sh
set -eu

wallpaper_dir=${LAPTOPUI_WALLPAPER_DIR:-"${HOME}/Wallpapers"}
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/laptopui"
state_file="$state_dir/wallpaper"
helper_dir="$HOME/.local/bin"

[ -d "$wallpaper_dir" ] || exit 0

current=$(cat "$state_file" 2>/dev/null || true)
next=$(find "$wallpaper_dir" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) -print | sort | awk -v current="$current" '
  $0 == current { found = 1; next }
  found { print; printed = 1; exit }
  { first = first ? first : $0 }
  END { if (!found && first) print first; else if (found && !printed) print first }
')

[ -n "$next" ] || exit 0
exec "$helper_dir/laptopui-wallpaper-set" "$next"
