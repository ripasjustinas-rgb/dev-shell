#!/usr/bin/env bash
set -euo pipefail

wallpaper_dir=${LAPTOPUI_WALLPAPER_DIR:-"${HOME}/Wallpapers"}
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/laptopui"
state_file="$state_dir/wallpaper"
helper_dir="$HOME/.local/bin"

[[ -d "$wallpaper_dir" ]] || exit 0

mapfile -d '' -t wallpapers < <(
  find "$wallpaper_dir" -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
    -print0
)
((${#wallpapers[@]} > 0)) || exit 0

current=""
[[ -f "$state_file" ]] && current=$(<"$state_file")

# Avoid showing the previous session's wallpaper when another choice exists.
candidates=()
for wallpaper in "${wallpapers[@]}"; do
  if ((${#wallpapers[@]} == 1)) || [[ "$wallpaper" != "$current" ]]; then
    candidates+=("$wallpaper")
  fi
done

selected=${candidates[RANDOM % ${#candidates[@]}]}
exec "$helper_dir/laptopui-wallpaper-set" "$selected"
