#!/usr/bin/env bash
set -euo pipefail

action=${1:-}
power_supply_dir=${LAPTOPUI_POWER_SUPPLY_DIR:-/sys/class/power_supply}

on_ac_power() {
  local supply type online
  local has_battery=0

  for supply in "$power_supply_dir"/*; do
    [[ -d "$supply" && -r "$supply/type" ]] || continue
    type=$(<"$supply/type")
    if [[ "$type" == Battery ]]; then
      has_battery=1
      continue
    fi
    [[ -r "$supply/online" ]] || continue
    online=$(<"$supply/online")
    [[ "$online" == 1 ]] && (( has_battery == 1 )) && return 0
  done

  # Some kernels enumerate the charger before the battery. Check again only
  # after establishing that this machine actually is a laptop.
  (( has_battery == 1 )) || return 1
  for supply in "$power_supply_dir"/*; do
    [[ -d "$supply" && -r "$supply/type" && -r "$supply/online" ]] || continue
    type=$(<"$supply/type")
    online=$(<"$supply/online")
    [[ "$type" != Battery && "$online" == 1 ]] && return 0
  done
  return 1
}

case "$action" in
  five-minute)
    on_ac_power || exec "$HOME/.local/bin/laptopui-lock"
    ;;
  ten-minute)
    if on_ac_power; then
      exec "$HOME/.local/bin/laptopui-lock"
    else
      # The charger may have been unplugged after the five-minute listener
      # already ran in AC mode. Ensure DPMS never hides an unlocked session.
      if ! pidof hyprlock >/dev/null; then
        "$HOME/.local/bin/laptopui-lock" --immediate-render &
        for _ in {1..20}; do
          pidof hyprlock >/dev/null && break
          sleep 0.1
        done
      fi
      exec hyprctl dispatch 'hl.dsp.dpms({action = "off"})'
    fi
    ;;
  twenty-minute)
    on_ac_power || exec systemctl suspend
    ;;
  *)
    printf '%s\n' 'Usage: laptopui-idle <five-minute|ten-minute|twenty-minute>' >&2
    exit 2
    ;;
esac
