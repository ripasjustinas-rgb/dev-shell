+static bongocat_error_t downsample_bongocat_sprite_sheet(generic_sprite_sheet_t& sheet) {
+  constexpr int SCALE = 2;
+  const int source_width = sheet.image.sprite_sheet_width;
+  const int source_height = sheet.image.sprite_sheet_height;
+  const int source_frame_width = sheet.frame_width;
+  const int source_frame_height = sheet.frame_height;
+  const int target_frame_width = source_frame_width / SCALE;
+  const int target_frame_height = source_frame_height / SCALE;
+  const int target_width = target_frame_width * sheet.total_frames;
+  const int target_height = target_frame_height;
+  const int channels = sheet.image.channels;
+  if (sheet.total_frames <= 0 || target_width <= 0 || target_height <= 0 || channels <= 0) {
+    return bongocat_error_t::BONGOCAT_ERROR_IMAGE;
+  }
+
+  auto target_pixels = make_allocated_array<uint8_t>(static_cast<size_t>(target_width) *
+                                                       static_cast<size_t>(target_height) *
+                                                       static_cast<size_t>(channels));
+  if (!target_pixels) {
+    return bongocat_error_t::BONGOCAT_ERROR_MEMORY;
+  }
+  ::memset(target_pixels.data, 0, target_pixels._size_bytes);
+
+  // Scale each frame from the same local origin. Scaling the entire odd-width
+  // sheet at once changes the sampling phase between frames and causes a
+  // visible one-pixel sideways wobble when the animation advances.
+  for (int frame = 0; frame < sheet.total_frames; frame++) {
+    blit_image_scaled(target_pixels.data, target_pixels._size_bytes, target_width, target_height, channels,
+                      sheet.image.pixels.data, sheet.image.pixels._size_bytes, source_width, source_height, channels,
+                      frame * source_frame_width, 0, source_frame_width, source_frame_height,
+                      frame * target_frame_width, 0, target_frame_width, target_frame_height,
+                      blit_image_color_order_t::RGBA, blit_image_color_order_t::RGBA,
+                      blit_image_color_option_flags_t::BilinearInterpolation);
+  }
+
+  sheet.image.pixels = bongocat::move(target_pixels);
+  sheet.image.sprite_sheet_width = target_width;
+  sheet.image.sprite_sheet_height = target_height;
+  sheet.frame_width = target_frame_width;
+  sheet.frame_height = target_frame_height;
+  return bongocat_error_t::BONGOCAT_SUCCESS;
+}
