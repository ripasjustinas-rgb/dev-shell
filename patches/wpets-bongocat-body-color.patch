 namespace bongocat::animation {

+static bool parse_bongocat_body_color(const char *value, uint8_t (&color)[3]) {
+  if (value == nullptr || value[0] != '#' || value[7] != '\0') {
+    return false;
+  }
+
+  uint32_t parsed = 0;
+  for (size_t i = 1; i < 7; i++) {
+    parsed <<= 4u;
+    const char digit = value[i];
+    if (digit >= '0' && digit <= '9') {
+      parsed |= static_cast<uint32_t>(digit - '0');
+    } else if (digit >= 'a' && digit <= 'f') {
+      parsed |= static_cast<uint32_t>(digit - 'a' + 10);
+    } else if (digit >= 'A' && digit <= 'F') {
+      parsed |= static_cast<uint32_t>(digit - 'A' + 10);
+    } else {
+      return false;
+    }
+  }
+
+  color[0] = static_cast<uint8_t>((parsed >> 16u) & 0xffu);
+  color[1] = static_cast<uint8_t>((parsed >> 8u) & 0xffu);
+  color[2] = static_cast<uint8_t>(parsed & 0xffu);
+  return true;
+}
+
+static void tint_bongocat_body(generic_sprite_sheet_image_t& image) {
+  uint8_t body_color[3]{};
+  if (!parse_bongocat_body_color(std::getenv("WPETS_BONGOCAT_BODY_COLOR"), body_color) || image.channels < 3) {
+    return;
+  }
+
+  for (size_t i = 0; i + 2 < image.pixels._size_bytes; i += static_cast<size_t>(image.channels)) {
+    const uint8_t red = image.pixels[i];
+    const uint8_t green = image.pixels[i + 1];
+    const uint8_t blue = image.pixels[i + 2];
+    const uint8_t darkest = red < green ? (red < blue ? red : blue) : (green < blue ? green : blue);
+    const uint8_t lightest = red > green ? (red > blue ? red : blue) : (green > blue ? green : blue);
+
+    // The source SVGs include red impact marks below the paws. At panel scale
+    // their antialiased edges look like dark artifacts on light wallpapers.
+    if (image.channels >= 4 && red > 140 && red > green + 70 && red > blue + 70) {
+      image.pixels[i] = 0;
+      image.pixels[i + 1] = 0;
+      image.pixels[i + 2] = 0;
+      image.pixels[i + 3] = 0;
+      continue;
+    }
+
+    // Preserve the pink paw details. Only tint grayscale body pixels; black
+    // strokes remain black while white and antialiased edges inherit color.
+    if (static_cast<int>(lightest) - static_cast<int>(darkest) <= 2) {
+      image.pixels[i] = static_cast<uint8_t>((static_cast<uint32_t>(body_color[0]) * lightest + 127u) / 255u);
+      image.pixels[i + 1] =
+          static_cast<uint8_t>((static_cast<uint32_t>(body_color[1]) * lightest + 127u) / 255u);
+      image.pixels[i + 2] =
+          static_cast<uint8_t>((static_cast<uint32_t>(body_color[2]) * lightest + 127u) / 255u);
+    }
+  }
+}
