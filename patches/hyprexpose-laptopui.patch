+    let text = if query.is_empty() {
+        "Search applications…".to_owned()
+    } else {
+        format!("Search applications: {query}")
+    };
+    let search_w = (width as f64 - pad * 2.0).min(720.0);
+    let search_x = (width as f64 - search_w) / 2.0;
+    let (r, g, b, a) = cfg.colors.card.rgba();
+    rounded_rect(cr, search_x, 14.0, search_w, 30.0, cfg.appearance.card_radius.min(15.0));
+    cr.set_source_rgba(r, g, b, a);
+    cr.fill().ok();
+    let layout = pangocairo::functions::create_layout(cr);
+    layout.set_text(&text);
+    layout.set_font_description(Some(&font));
+    layout.set_width(((search_w - 24.0) * pango::SCALE as f64) as i32);
+    layout.set_ellipsize(pango::EllipsizeMode::End);
+    let (r, g, b, a) = cfg.colors.label.rgba();
+    cr.set_source_rgba(r, g, b, if query.is_empty() { a * 0.65 } else { a });
+    cr.move_to(search_x + 12.0, 21.0);
+    pangocairo::functions::show_layout(cr, &layout);
+}
