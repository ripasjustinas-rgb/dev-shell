#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
qml_root="$root/dotfiles/.config/quickshell/laptopui"

for file in "$root"/install.sh "$root"/scripts/* "$root"/dotfiles/.local/bin/laptopui-*; do
  [[ -f "$file" ]] && bash -n "$file"
done

if command -v qmlimportscanner >/dev/null 2>&1; then
  # qmlimportscanner parses the complete shell import graph without requiring
  # a Wayland backend, unlike qmllint on distributions with runtime-only
  # Quickshell modules.
  qmlimportscanner -rootPath "$qml_root" -qmlFiles "$qml_root/shell.qml" >/dev/null
else
  echo "SKIP: qmlimportscanner is unavailable; graphical QML smoke test requires a Hyprland/Wayland session."
fi

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
  echo "SKIP: runtime QML smoke test requires an active Hyprland/Wayland session."
fi

if [[ "${1:-}" == "--diff" ]]; then git -C "$root" diff --check; fi
echo "Quickshell helper checks passed."
